# GitHub and workspace credentials
GITHUB_TOKEN=your_github_token_here

# Internal API authentication for outbound write proxies
API_KEY=your_api_key_here

# Slack integration
SLACK_TOKEN=your_slack_token_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_CHANNEL_ID=your_slack_channel_id_here
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/oauth/callback

# Jira integration
JIRA_USER=your_jira_username
JIRA_TOKEN=your_jira_api_token
JIRA_HOST=your-company.atlassian.net

# Discord integration
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# AI provider keys used by workspace agents
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# Optional CLI/tool discovery hints
ANTIGRAVITY_VERSION=your_antigravity_version_here
ANTIGRAVITY_CLI_PATH=/path/to/antigravity
DATADOG_API_KEY=your_datadog_api_key_here

PORT=3001
